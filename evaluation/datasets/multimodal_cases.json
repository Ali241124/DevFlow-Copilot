      "input_mode": "text_only",
      "client_text": "Build a task management application. Users should be able to register, log in, create tasks, edit tasks, delete tasks, and mark tasks as completed.",
      "image": null,
      "expected": {
        "required_features": [
          "user registration",
          "user login",
          "create tasks",
          "edit tasks",
          "delete tasks",
          "complete tasks"
        ],
        "should_identify_unknowns": true
      }
    },
